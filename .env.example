# traffic page (/stats); copy to .env.local for next dev or .dev.vars for wrangler,
# and set each one in production with `npx wrangler secret put <NAME>`.
# every source is optional; a panel shows "not connected" until its values are set.

# cloudflare dashboard → huzhihui.com → overview → zone id (right sidebar)
CLOUDFLARE_ZONE_ID=
# my profile → api tokens → create custom token: zone · analytics · read, limited to huzhihui.com
CLOUDFLARE_ANALYTICS_TOKEN=

# google cloud service account key (the downloaded json, one line or base64); shared by ga4 and search console
GOOGLE_SERVICE_ACCOUNT_JSON=
# ga4 admin → property details → numeric property id (not G-XXXX)
GA4_PROPERTY_ID=
# search console property name: sc-domain:huzhihui.com for a domain property, https://ui.huzhihui.com/ for a url prefix
GSC_SITE_URL=

# bing webmaster tools → settings → api access → api key
BING_WEBMASTER_API_KEY=
# defaults to https://ui.huzhihui.com/; must match the site as bing lists it
BING_WEBMASTER_SITE_URL=
